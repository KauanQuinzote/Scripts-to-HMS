# URL base do Jira (ex: https://seu-dominio.atlassian.net)
JIRA_BASE_URL=https://plataformahms.atlassian.net

# Email de login da sua conta Atlassian
JIRA_EMAIL=seu-email@dominio.com

# Token de API gerado em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=seu_api_token_aqui

# Código da Chave do Projeto (ex: SCRUM)
JIRA_PROJECT_KEY=SCRUM

# ID do Board (opcional - se omitido, o script tenta descobrir automaticamente usando a PROJECT_KEY)
# JIRA_BOARD_ID=1

# Tipo de edição Jira padrão (opcional - padrão: Story)
# JIRA_ISSUE_TYPES=Story

